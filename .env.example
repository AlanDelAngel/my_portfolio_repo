# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=900
ALLOWED_ORIGINS=https://alandelangel.dev,https://www.alandelangel.dev
RATE_LIMIT_SALT=any-long-random-string
# Optional: shared rate limits (Upstash Redis from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
